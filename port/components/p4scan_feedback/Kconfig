menu "P4SCAN Status LED"

    config P4SCAN_STATUS_LED_GPIO
        int "WS2812 status LED GPIO"
        range 0 54
        default 51
        help
            GPIO connected to the data input of the WS2812 status LED.

    config P4SCAN_STATUS_LED_COUNT
        int "WS2812 LED count"
        range 1 64
        default 1
        help
            Number of addressable LEDs in the status LED chain.

    config P4SCAN_STATUS_LED_BRIGHTNESS
        int "WS2812 status LED brightness"
        range 0 255
        default 32
        help
            Global RGB brightness limit from 0 to 255.

endmenu
