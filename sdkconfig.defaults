CONFIG_IDF_TARGET="esp32p4"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_EN=n

# OV9281: 2-lane MIPI CSI, 24 MHz XCLK, 1280x720 RAW8 at 50 fps.
CONFIG_P4SCAN_CAMERA_APP=y
CONFIG_P4SCAN_CONTINUOUS_SCAN=y
CONFIG_P4SCAN_QR_FAST_SEARCH=y
CONFIG_P4SCAN_TRIGGER_GPIO=35
CONFIG_P4SCAN_LIGHT_DIAGNOSTIC=n
CONFIG_P4SCAN_SOFTWARE_TRIGGER_ON_BOOT=n
CONFIG_P4SCAN_DUMP_FRAME_TO_FLASH=n
CONFIG_CAMERA_OV9281=y
CONFIG_CAMERA_OV9281_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV9281_MIPI_RAW8_640X400_100FPS=y
CONFIG_CAMERA_OV9281_SID_LOW=y
CONFIG_CAMERA_OV9281_ABSOLUTE_GAIN_LIMIT=4000
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_ESP_VIDEO_DISABLE_MIPI_CSI_DRIVER_BACKUP_BUFFER=y
CONFIG_TINYUSB_RHPORT_HS=y
CONFIG_TUSB_PID=0x8001
CONFIG_TUSB_PRODUCT="P4SCAN OV9281 UVC+CDC"
CONFIG_UVC_MODE_ISOC_CAM1=y
CONFIG_UVC_CAM1_FRAMESIZE_WIDTH=1280
CONFIG_UVC_CAM1_FRAMESIZE_HEIGT=720
CONFIG_UVC_CAM1_MULTI_FRAMESIZE=n
CONFIG_UVC_TINYUSB_TASK_CORE=0
CONFIG_UVC_CAM1_TASK_CORE=0
CONFIG_CAMERA_OV9281_MIPI_RAW8_1280X720_50FPS=y
CONFIG_CAMERA_OV9281_MIPI_DEFAULT_FMT_RAW8_1280X720_50FPS=y
CONFIG_UVC_CAM1_FRAMERATE=30
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U32=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

CONFIG_UVC_TINYUSB_TASK_PRIORITY=10

CONFIG_UVC_CAM1_TASK_PRIORITY=9

# CONFIG_UVC_MODE_BULK_CAM1 is not set
